  "description": "MCP server for Tella TV — list videos, manage playlists, webhooks, and cinematic zoom annotations for product recordings.",
  "main": "dist/index.js",
  "bin": {
    "tella-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
